            Associates &{" "}
            <span className="bg-secondary bg-clip-text text-transparent">
              Supporting Partners
            </span>
          </h2>
          <p className="text-gray-600 text-base max-w-2xl mx-auto">
            Proud to be supported by leading organizations in healthcare and wellness
          </p>
        </div>

        {/* MARQUEE CONTAINER - 2 Rows */}
        <div className="space-y-6">
          
          {/* First Row - Left to Right */}
          <div className="relative overflow-hidden py-4">
            <div className="marquee-container">
              <div className="marquee-content">
                {/* First Set */}
                {sponsors.slice(0, 14).map((icon, idx) => (
                  <div key={`row1-${idx}`} className="sponsor-item group">
                    <div className="relative w-44 h-32 bg-white/80 backdrop-blur-sm rounded-3xl p-5 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-emerald-200/50 hover:border-emerald-400 overflow-hidden">
                      {/* Animated gradient border glow */}
                      <div className="absolute inset-0 bg-gradient-to-r from-emerald-400/0 via-emerald-400/30 to-emerald-400/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-xl"></div>
                      
                      {/* Shine effect */}
                      <div className="absolute inset-0 bg-gradient-to-br from-transparent via-white/60 to-transparent -translate-x-full -translate-y-full group-hover:translate-x-full group-hover:translate-y-full transition-transform duration-1000 pointer-events-none"></div>
                      
                      <img
                        src={icon}
                        alt={`Sponsor ${idx + 1}`}
                        className="w-full h-full object-contain filter-none group-hover:scale-110 transition-all duration-500"
                      />
                    </div>
                  </div>
                ))}
                {/* Duplicate for seamless loop */}
                {sponsors.slice(0, 14).map((icon, idx) => (
                  <div key={`row1-dup-${idx}`} className="sponsor-item group">
                    <div className="relative w-44 h-32 bg-white/80 backdrop-blur-sm rounded-3xl p-5 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-emerald-200/50 hover:border-emerald-400 overflow-hidden">
